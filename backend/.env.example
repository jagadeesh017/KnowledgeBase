KP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge
KP_VECTOR_STORE_BACKEND=pgvector
KP_DB_POOL_MIN_SIZE=1
KP_DB_POOL_MAX_SIZE=10
KP_JOB_POLL_INTERVAL_SECONDS=1
KP_JOB_MAX_ATTEMPTS=3
KP_JOB_RETRY_BACKOFF_SECONDS=5
KP_OLLAMA_HOST=http://localhost:11434
KP_OLLAMA_TIMEOUT_SECONDS=60
KP_OLLAMA_RETRIES=2
KP_OLLAMA_RETRY_BACKOFF_SECONDS=0.5
KP_MAX_UPLOAD_BYTES=20971520
KP_EMBEDDING_MODEL=nomic-embed-text
KP_CHAT_MODEL=qwen2.5:3b
KP_CHROMA_PATH=./chroma
KP_DEFAULT_COLLECTION=knowledge
KP_CHUNK_SIZE=500
KP_CHUNK_OVERLAP=50
KP_TOP_K=5
KP_SEMANTIC_BREAK_QUANTILE=0.75
KP_EMBEDDING_BATCH_SIZE=64
KP_AUTH_ENABLED=true
KP_API_KEYS={"local-dev-key":"local"}
KP_LOG_LEVEL=INFO
